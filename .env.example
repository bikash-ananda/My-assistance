# Run scripts/setup.ps1 to create owner authentication values; do not copy blank secrets into production.
BIKASH_DATABASE_PATH=./data/bikash.sqlite3
BIKASH_SESSION_MINUTES=720
BIKASH_COOKIE_SECURE=false
MODEL_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
BIKASH_WEB_PORT=3080
# Leave blank until a Google OAuth web client is configured and the owner consents.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Generated by scripts/setup.ps1; never publish the value from your local .env.
BIKASH_GOOGLE_TOKEN_ENCRYPTION_KEY=
